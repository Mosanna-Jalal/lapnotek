# Copy this file to .env and fill in the values. .env is git-ignored.

# MongoDB Atlas connection string for the "lapnotek" database.
# Leave it empty to run the site on the built-in demo catalogue.
MONGODB_URI=
MONGODB_DB=lapnotek

# MapTiler key for the store map: https://cloud.maptiler.com/account/keys/
NEXT_PUBLIC_MAPTILER_KEY=
